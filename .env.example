# ==============================================================================
# Lenny Growth Assistant — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# Never commit real API keys, passwords, or production secrets to Git.
# All values below are safe defaults or placeholders for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
APP_NAME="Lenny Growth Assistant"
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# Async connection URL used by FastAPI and SQLAlchemy (via asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth_db

# Synchronous connection URL used by database migrations (Alembic) and ingestion scripts
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/lenny_growth_db

# Database container environment configuration (matches docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Model Providers & Agent Runtime
# ------------------------------------------------------------------------------
# Agent runtime implementation: "pi" (internal Node runtime using Pi Coding Agent SDK)
AGENT_RUNTIME=pi

# Active provider: "openai" (cloud default) or "ollama" (local demo)
# Requests specify provider; fallback is always manual and visible
DEFAULT_LLM_PROVIDER=openai

# --- Cloud Provider: OpenAI ---
# Only paid cloud provider. Developer budget ceiling is approximately US$4.00.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BUDGET_USD=4.00

# Optional configuration-only check (not default under current budget)
# OPENAI_MODEL=gpt-4o

# --- Local Provider: Ollama ---
# Mandatory local demo path targeting CPU-only machine (<= 2B parameter cap)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# For evaluators with stronger hardware (7B/8B parameter models via configuration):
# OLLAMA_MODEL=llama3.1:8b

# ------------------------------------------------------------------------------
# 4. Embeddings & Ingestion
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# 5. Retrieval Parameters
# ------------------------------------------------------------------------------
# Default candidate count and cosine similarity threshold for evidence grounding
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 6. Frontend Public Configuration (Next.js)
# ------------------------------------------------------------------------------
# Public URL for the browser to communicate with the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
